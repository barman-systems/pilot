diff --git a/.github/workflows/booking-lifecycle-regression.yml b/.github/workflows/booking-lifecycle-regression.yml
new file mode 100644
index 0000000..d1c7b48
--- /dev/null
+++ b/.github/workflows/booking-lifecycle-regression.yml
@@ -0,0 +1,41 @@
+name: Booking lifecycle regression
+on:
+  pull_request:
+    paths:
+      - 'api/**'
+      - 'test/dabbir-booking-lifecycle*.test.mjs'
+      - 'scripts/qa-booking-lifecycle-browser.mjs'
+      - '.github/workflows/booking-lifecycle-regression.yml'
+permissions:
+  contents: read
+jobs:
+  browser:
+    name: Booking lifecycle browser regression
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          persist-credentials: false
+      - uses: actions/setup-node@v7
+        with:
+          node-version: '24'
+      - name: Lifecycle and authenticated API regressions
+        run: node --test test/dabbir-booking-lifecycle*.test.mjs
+      - name: Install pinned isolated browser verifier
+        run: |
+          npm install --prefix "$RUNNER_TEMP/booking-playwright" --no-audit --no-fund --ignore-scripts playwright@1.63.0
+          node "$RUNNER_TEMP/booking-playwright/node_modules/playwright/cli.js" install --with-deps chromium webkit
+      - name: iPhone and iPad browser matrix over real served UI
+        env:
+          PLAYWRIGHT_PATH: ${{ runner.temp }}/booking-playwright/node_modules/playwright
+          BOOKING_BROWSER_OUTPUT: booking-browser-evidence
+        run: node scripts/qa-booking-lifecycle-browser.mjs
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: booking-lifecycle-browser-${{ github.run_id }}
+          path: booking-browser-evidence/
+          retention-days: 7
+          if-no-files-found: warn
