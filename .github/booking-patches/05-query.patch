index 0000000..cf45f48
--- /dev/null
+++ b/api/_booking-query.js
@@ -0,0 +1,38 @@
+import { bookingLifecycle as lifecycle } from './_booking-lifecycle.js';
+
+// Resolve a wall-clock midnight without depending on the server/device timezone.
+export function bookingDayStart(day, business) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(day)) || lifecycle.wallKey(lifecycle.wallDate(day)) !== day) {
+    throw Object.assign(new Error('INVALID_BOOKING_DATE'), {status:400});
+  }
+  const target = Date.parse(day + 'T00:00:00.000Z');
+  let value = target;
+  for (let attempt = 0; attempt < 4; attempt++) {
+    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-CA', {
+      timeZone:lifecycle.timezone(business), year:'numeric', month:'2-digit', day:'2-digit',
+      hour:'2-digit', minute:'2-digit', second:'2-digit', hourCycle:'h23',
+    }).formatToParts(new Date(value)).map(p => [p.type,p.value]));
+    const observed = Date.UTC(+parts.year,+parts.month-1,+parts.day,+parts.hour,+parts.minute,+parts.second);
+    const next = value + target - observed;
+    if (next === value) return new Date(value).toISOString();
+    value = next;
+  }
+  throw Object.assign(new Error('BOOKING_TIMEZONE_BOUNDARY_UNRESOLVED'), {status:400});
+}
+
+export function bookingQuery({business, scope='current', from, to, now=Date.now()}) {
+  if (!['current','review','history'].includes(scope)) throw Object.assign(new Error('INVALID_BOOKING_SCOPE'),{status:400});
+  const stamp = new Date(now).toISOString();
+  const today = bookingDayStart(lifecycle.dayKey(now,business),business);
+  const filters = [scope==='history' ? 'status.in.(completed,cancelled,no_show)' : 'status.not.in.(completed,cancelled,no_show)'];
+  // The database constrains valid end times to be greater than their start time.
+  if (scope==='current') filters.push('starts_at.not.is.null',`or(ends_at.gt.${stamp},and(ends_at.is.null,starts_at.gte.${today}))`);
+  if (scope==='review') filters.push(`or(starts_at.is.null,ends_at.lte.${stamp},and(ends_at.is.null,starts_at.lt.${today}))`);
+  if (from || to) {
+    if (!from || !to) throw Object.assign(new Error('BOOKING_DATE_RANGE_REQUIRED'),{status:400});
+    const first=bookingDayStart(from,business), last=bookingDayStart(to,business);
+    if (last<=first || Date.parse(last)-Date.parse(first)>367*86400000) throw Object.assign(new Error('INVALID_BOOKING_DATE_RANGE'),{status:400});
+    filters.push(`starts_at.lt.${last}`,`or(ends_at.gt.${first},and(ends_at.is.null,starts_at.gte.${first}))`);
+  }
+  return 'and='+encodeURIComponent('('+filters.join(',')+')');
+}
