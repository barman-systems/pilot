{
  "version": "DABBIR_AI_PROVIDER_RELIABILITY_AUTHORITY_V3",
  "authority": "api/_ai-provider-reliability.js",
  "routing_readiness_authority": "api/_ai-provider-readiness.js",
  "authority_fetch_adapter": "api/_ai-provider-authority-fetch.js",
  "automatic_generation_routing": {
    "primary": "vercel-ai-gateway",
    "direct_recovery_readiness": "api/_ai-provider-readiness.js",
    "diagnostic_credentials_do_not_imply_recovery": true,
    "gemini_generation_recovery_production_state": "RETIRED",
    "gemini_diagnostic_capability_retained": true
  },
  "background_recovery": {
    "worker": "api/_ai-provider-recovery.js",
    "cron": "api/dabbir-ai-provider-recovery-cron.js",
    "attempt_type": "RECOVERY_PROBE",
    "customer_content_allowed": false,
    "single_probe_lease": true,
    "required_successes_to_healthy": 2
  },
  "attempt_types": [
    "CUSTOMER",
    "RECOVERY_PROBE",
    "BENCHMARK"
  ],
  "invariants": {
    "customer_can_acquire_probe_lease": false,
    "customer_network_probe_allowed": false,
    "recovery_probe_requires_shared_lease": true,
    "benchmark_mutates_customer_health_state": false,
    "configured_credential_counts_as_automatic_recovery": false,
    "health_readiness_uses_routing_readiness_authority": true
  },
  "shared_state": {
    "backend": "supabase_postgres",
    "table": "dabbir_private.dabbir_ai_provider_health_v1",
    "claim_rpc": "dabbir_ai_provider_health_claim_v1",
    "observe_rpc": "dabbir_ai_provider_health_observe_v1"
  },
  "providers": [
    "google-gemini",
    "groq",
    "cloudflare-workers-ai",
    "vercel-ai-gateway"
  ],
  "delegated_transport_cores": {
    "api/_dabbir-whatsapp-voice.js": {
      "production_adapter": "api/_dabbir-whatsapp-voice-reliable.js",
      "reason": "Legacy voice behavior is retained, but production STT transport receives an authority-controlled fetch implementation. The webhook may import persistSignedVoiceInbound only; it performs no provider transport."
    },
    "api/_dabbir-daily-operator-core.js": {
      "production_adapter": "api/_dabbir-daily-operator-reliable.js",
      "reason": "Legacy daily-report behavior is retained; the production cron imports the reliable adapter that supplies the authority-controlled transport."
    }
  },
  "transport_adapters": [
    "api/_dabbir-qwen37-canary.js"
  ],
  "diagnostic_exemptions": {
    "api/_dabbir-qwen37-benchmark.js": {
      "entrypoint": "api/dabbir-qwen37-benchmark.js",
      "workflow": ".github/workflows/dabbir-qwen37-live-benchmark.yml",
      "reason": "Explicit isolated benchmark/diagnostic surface; not a production customer or operator routing path."
    }
  },
  "protected_entrypoints": {
    "dabbir_reply_core": [
      "api/dabbir-ai.js",
      "api/chat-send.js",
      "api/chat-recover.js",
      "api/owner-copilot.js",
      "api/dabbir-runtime.js",
      "api/_dabbir-semantic-interpreter.js",
      "api/_dabbir-conversation-v3-interpreter.js"
    ],
    "knowledge": ["api/_dabbir-knowledge-rag.js"],
    "voice": ["api/dabbir-whatsapp-voice-worker.js", "api/dabbir-whatsapp-ai-cron.js"],
    "daily_operator": ["api/dabbir-daily-operator-cron.js"],
    "barman": [
      "api/_barman-executive-core.js",
      "api/_barman-executive-automation.js",
      "api/barman-tool-agent-broker.js"
    ]
  }
}
